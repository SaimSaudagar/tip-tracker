{
  "expo": {
    "name": "Tipbook",
    "slug": "tip-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tipbook",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.saimsaudagar.tipbook",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.saimsaudagar.tipbook"
        ]
      }
    },
    "android": {
      "package": "com.saimsaudagar.tipbook",
      "adaptiveIcon": {
        "backgroundColor": "#0B7A4B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "allowBackup": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B7A4B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#0A2A1D",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0B7A4B"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Tipbook reads the totals from a photo of your checkout slip. The photo stays on your phone.",
          "cameraPermission": "Tipbook uses the camera to read the totals on your checkout slip. The photo stays on your phone.",
          "microphonePermission": false
        }
      ],
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "WeekWidget",
              "label": "Tipbook: this week",
              "description": "Your tips and real hourly this week. Tap to log a shift.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/with-shortcuts.js",
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "es"]
        }
      ]
    ],
    "locales": {
      "es": "./locales/es.json"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "saimsaudagars-team",
    "extra": {
      "eas": {
        "projectId": "627935a0-a872-4a89-89ca-e8684f61d449"
      }
    }
  }
}
